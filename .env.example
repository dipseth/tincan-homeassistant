# Tin Can credentials — the ONLY config the integration needs.
# Copy to ".env" (next to tc_api.py) and fill in your parent login.
# tc_api.py auto-loads this file; it caches the JWT + refresh token in ~/.tc_token (chmod 600).

TC_EMAIL=you@example.com
TC_PASSWORD=your-tin-can-password

# --- optional, only for the reference MQTT bridge (reference/tc2mqtt.py); NOT needed for a HACS integration ---
# MQTT_HOST=homeassistant.local
# MQTT_PORT=1883
# MQTT_USER=
# MQTT_PASS=
# TC_POLL=30            # full poll interval (devices/subs/contacts/presence)
# TC_FAST_POLL=8        # CDR-only poll for near-live Recent Call
# TC_RING_WINDOW=30     # seconds Recent Call stays ON after a call ends
